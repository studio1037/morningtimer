{
  "name": "morningtimer-qa",
  "private": true,
  "scripts": {
    "dev": "python3 -m http.server 4173 --bind 127.0.0.1",
    "test": "playwright test",
    "test:baseline": "playwright test --grep-invert \"@recovery|@v29-contract\"",
    "test:defects": "playwright test --grep @recovery",
    "test:report": "playwright show-report",
    "test:contracts": "playwright test --grep @v29-contract"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
